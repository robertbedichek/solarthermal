        <!-- Hot Water Coil -->
        <mxCell id="4" value="DHW Coil" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="220" width="40" height="160" as="geometry"/>
        </mxCell>

        <!-- Spa -->
        <mxCell id="5" value="Spa" style="shape=cylinder;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="80" height="80" as="geometry"/>

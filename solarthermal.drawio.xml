        <!-- Spa Coil -->
        <mxCell id="3" value="Spa Coil" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="220" width="40" height="160" as="geometry"/>
